{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/Ricing/Custom Icons/Arch_Linux_2D_Icon.png",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 4
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": false,
    "hideCursor": false,
    "separator": "  ",
    "color": {
      "keys": "",
      "title": "",
      "output": "",
      "separator": ""
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      },
      "width": 10
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default"
    },
    "noBuffer": false,
    "key": {
      "width": 0,
      "type": "string",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#keys}╭────────────╮"
    },
    {
      "type": "title",
      "key": "│  user     │",
      "format": "{1}"
    },
    {
      "type": "title",
      "key": "│ 󰇅 hostn    │",
      "format": "{2}"
    },
    {
      "type": "custom",
      "format": "{#keys}├────────────┤"
    },
    {
      "type": "kernel",
      "key": "│  kernel   │"
    },
    {
      "type": "os",
      "key": "│  distro   │"
    },
    {
      "type": "wm",
      "key": "│  winman   │",
      "detectPlugin": true
    },
    {
      "type": "terminal",
      "key": "│  term     │"
    },
    {
      "type": "shell",
      "key": "│  shell    │"
    },
    {
      "type": "custom",
      "format": "{#keys}├────────────┤"
    },
    {
      "type": "cpu",
      "key": "│  cpu      │",
      "format": "{1}",
      "temp": false,
      "showPeCoreCount": true,
      "tempSensor": ""
    },
    {
      "type": "gpu",
      "key": "│ 󰾲 gpu      │",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "Integrated",
      "format": "{2}",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "memory",
      "key": "│  mem      │",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "disk",
      "key": "│  disk     │",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "custom",
      "format": "{#keys}├────────────┤"
    },
    {
      "type": "weather",
      "key": "│ 󰖙 weather  │",
      "location": "Madrid",
      "outputFormat": "%t+-+%C+(%l)",
      "timeout": 1000
    },
    {
      "type": "colors",
      "key": " ",
      "key": "│  colors   │",
      "symbol": "circle",
      "paddingLeft": 0,
      "block": {
        "width": 1,
        "range": [
          0,
          15
        ]
      },
      "brightness": "default"
    },
    {
      "type": "custom",
      "format": "{#keys}╰────────────╯"
    }
  ]
}
